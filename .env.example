# Environment Configuration for DocMediaLink Maestro Tests
# Copy this file to .env and fill in your values

# API Configuration
API_BASE_URL=http://localhost:8080
API_TIMEOUT=30

# Test Credentials
TEST_USERNAME=testuser@docmedilink.com
TEST_PASSWORD=testpassword123
TEST_EMAIL=testuser@docmedilink.com

# App Configuration
APP_ID=com.docmedilink.mobile
APP_PACKAGE=com.docmedilink

# Test Environment (dev, staging, production)
TEST_ENV=dev

# Cloud Testing (Optional - for Maestro Cloud)
MAESTRO_CLOUD_API_KEY=your_api_key_here
MAESTRO_CLOUD_APP_ID=your_cloud_app_id

# Notification Settings
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#maestro-tests
